# Application
APP_NAME=KYHC API
APP_VERSION=1.0.0

# PostgreSQL connection string
#
# Local development:
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kyhc_db
#
# Supabase (see docs/DEPLOYMENT.md):
#   Direct / session pooler (port 5432):
#     postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
#   Transaction pooler (port 6543, requires DATABASE_PREPARE_STATEMENTS=false):
#     postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kyhc_db

# Set to false when using a transaction-mode pooler (Supabase port 6543)
# or when you see "prepared statement already exists" errors.
DATABASE_PREPARE_STATEMENTS=true

# JWT settings - generate a strong secret for production
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set to true to log every SQL statement
SQL_ECHO=false

# Allowed CORS origins (comma separated or JSON array)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
